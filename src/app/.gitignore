# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Suggested additions below:

# IDE and editor files
.vscode/          # VS Code settings and extensions
.idea/            # JetBrains IDEs (e.g., WebStorm, IntelliJ)
*.sublime-*       # Sublime Text files

# OS-specific files
Thumbs.db         # Windows thumbnail cache

# Linting and formatting
.eslintcache      # ESLint cache
.prettierignore   # Prettier ignore file (if not committed)

# Package manager lockfiles (optional, depending on preference)
/package-lock.json  # npm lockfile
/yarn.lock         # Yarn lockfile
/pnpm-lock.yaml    # pnpm lockfile

# Build tools and caches
/dist             # Common output directory for builds
/cache            # Generic cache folder (e.g., used by some tools)

# Testing frameworks (if applicable)
/cypress          # Cypress testing artifacts
/playwright       # Playwright testing artifacts
*.spec.*          # Test files (if you don’t want them tracked)

# Mac-specific (additional)
/*.DS_Store       # Catch DS_Store in subdirectories
Icon?             # Custom Finder icons

# Logs
/logs             # Generic logs folder
*.log             # Any other log files